NODE_ENV=test
APP_NAME=AfriScout
APP_URL=http://localhost:5173
API_URL=http://localhost:4000
API_PORT=4001
API_HOST=127.0.0.1
LOG_LEVEL=error
TZ=UTC

VITE_API_URL=http://localhost:4001/api/v1
VITE_PUBLIC_APP_URL=http://localhost:5173
VITE_ENABLE_DEVTOOLS=false

DATABASE_URL=postgresql://afriscout_test:afriscout_test@localhost:5433/afriscout_test?schema=public
DATABASE_POOL_MIN=1
DATABASE_POOL_MAX=5
DATABASE_SSL=false

REDIS_URL=redis://localhost:6380
REDIS_PREFIX=afriscout_test
REDIS_TLS=false

JWT_ACCESS_SECRET=test_access_secret_replace_in_real_env_min_64_chars_aaaaaaaaaaaaaaaaaaaa
JWT_REFRESH_SECRET=test_refresh_secret_replace_in_real_env_min_64_chars_bbbbbbbbbbbbbbbbbb
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
JWT_ISSUER=afriscout
JWT_AUDIENCE=afriscout-web
PASSWORD_HASH_MEMORY_COST=8192
PASSWORD_HASH_TIME_COST=1
PASSWORD_HASH_PARALLELISM=1

SUPER_ADMIN_EMAIL=admin@test.local
SUPER_ADMIN_PASSWORD=TestPassword123!
SUPER_ADMIN_FULL_NAME=Test Administrator

CORS_ORIGINS=http://localhost:5173

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=1000
RATE_LIMIT_API_KEY_MAX=1000

APIFY_TOKEN=
APIFY_BASE_URL=https://api.apify.com/v2
APIFY_OPPORTUNITY_DISCOVERY_ACTOR_ID=
APIFY_DOCUMENT_EXTRACTOR_ACTOR_ID=
APIFY_OPPORTUNITY_MONITOR_ACTOR_ID=
APIFY_WEBHOOK_SECRET=test_apify_webhook_secret_min_32_chars_cccccccccc
APIFY_DEFAULT_TIMEOUT_SECONDS=120
APIFY_DEFAULT_MEMORY_MB=256

AI_ENABLED=false
AI_PROVIDER_PRIMARY=mock
AI_PROVIDER_FALLBACK_1=mock
AI_PROVIDER_FALLBACK_2=mock
AI_PROVIDER_FALLBACK_3=mock
AI_REQUEST_TIMEOUT_MS=5000
AI_MAX_RETRIES=0

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

SMTP_ENABLED=false
WEB_PUSH_ENABLED=false

STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./.storage-test

OUTBOUND_WEBHOOK_SECRET=test_outbound_webhook_secret_min_32_chars_dddddddddd
OUTBOUND_WEBHOOK_MAX_ATTEMPTS=1
OUTBOUND_WEBHOOK_TIMEOUT_MS=2000

WORKER_CONCURRENCY=1
QUEUE_PREFIX=afriscout_test
JOB_ATTEMPTS_DEFAULT=1
JOB_BACKOFF_MS=100

SCHEDULER_ENABLED=false
SCHEDULER_SOURCE_TICK_CRON=*/15 * * * *
SCHEDULER_DEADLINE_TICK_CRON=0 * * * *
SCHEDULER_EXPIRY_TICK_CRON=0 2 * * *
SCHEDULER_HEALTH_TICK_CRON=*/5 * * * *

SENTRY_DSN=
SENTRY_ENVIRONMENT=test

FEATURE_ASK_AFRISCOUT=true
FEATURE_OPPORTUNITY_MAP=true
FEATURE_API_PORTAL=true
FEATURE_PUBLIC_API=true

PLAN_FREE_RPM=1000
PLAN_PRO_RPM=1000
PLAN_BUSINESS_RPM=1000
PLAN_ENTERPRISE_RPM=1000