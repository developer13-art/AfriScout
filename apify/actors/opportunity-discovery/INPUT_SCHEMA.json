{
  "title": "AfriScout Opportunity Discovery Input",
  "type": "object",
  "schemaVersion": 1,
  "properties": {
    "sourceId": {
      "type": "string",
      "title": "Source ID",
      "description": "The AfriScout source identifier.",
      "editor": "textfield"
    },
    "sourceUrl": {
      "type": "string",
      "title": "Source URL",
      "description": "The public listing URL to crawl.",
      "editor": "textfield"
    },
    "sourceType": {
      "type": "string",
      "title": "Source type",
      "description": "Source family hint.",
      "editor": "textfield"
    },
    "adapter": {
      "type": "string",
      "title": "Adapter key",
      "description": "The adapter to use for extraction.",
      "editor": "textfield"
    },
    "country": {
      "type": "string",
      "title": "Country code",
      "description": "Optional ISO country code.",
      "editor": "textfield"
    },
    "category": {
      "type": "string",
      "title": "Category hint",
      "description": "Optional category hint.",
      "editor": "textfield"
    },
    "maxItems": {
      "type": "integer",
      "title": "Maximum items",
      "description": "Upper limit on items to extract.",
      "default": 20,
      "minimum": 1,
      "maximum": 5000,
      "editor": "number"
    },
    "requestTimeoutSeconds": {
      "type": "integer",
      "title": "Request timeout (seconds)",
      "description": "Per-request network timeout in seconds.",
      "default": 60,
      "minimum": 5,
      "maximum": 3600,
      "editor": "number"
    },
    "waitUntil": {
      "type": "string",
      "title": "Wait until",
      "description": "Playwright navigation wait strategy.",
      "enum": ["load", "domcontentloaded", "networkidle", "commit"],
      "default": "domcontentloaded",
      "editor": "select"
    },
    "waitForSelector": {
      "type": "string",
      "title": "Wait for selector",
      "description": "Optional CSS selector that must appear before extraction.",
      "editor": "textfield"
    },
    "waitExtraMs": {
      "type": "integer",
      "title": "Extra wait (ms)",
      "description": "Additional wait after navigation.",
      "default": 0,
      "minimum": 0,
      "maximum": 60000,
      "editor": "number"
    },
    "listingSelector": {
      "type": "string",
      "title": "Listing selector",
      "description": "Optional CSS selector that scopes the listing. Each matched element (or each row inside it) becomes one item.",
      "editor": "textfield"
    }
  },
  "required": ["sourceId", "sourceUrl", "sourceType", "adapter"]
}