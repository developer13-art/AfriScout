# =============================================================
# AfriScout — Environment Configuration
# Copy to .env and fill in real values. Never commit .env.
# =============================================================

# ---------- Runtime ----------
NODE_ENV=development
APP_NAME=AfriScout
APP_URL=http://localhost:5173
API_URL=http://localhost:4000
API_PORT=4000
API_HOST=0.0.0.0
LOG_LEVEL=debug
TZ=UTC

# ---------- Frontend (apps/web) ----------
VITE_API_URL=http://localhost:4000/api/v1
VITE_PUBLIC_APP_URL=http://localhost:5173
VITE_ENABLE_DEVTOOLS=true

# ---------- PostgreSQL ----------
DATABASE_URL=postgresql://afriscout:afriscout@localhost:5432/afriscout?schema=public
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_SSL=false

# ---------- Redis ----------
REDIS_URL=redis://localhost:6379
REDIS_PREFIX=afriscout
REDIS_TLS=false

# ---------- Auth ----------
JWT_ACCESS_SECRET=replace_with_a_long_random_string_min_64_chars
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string_min_64_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
JWT_ISSUER=afriscout
JWT_AUDIENCE=afriscout-web
PASSWORD_HASH_MEMORY_COST=19456
PASSWORD_HASH_TIME_COST=2
PASSWORD_HASH_PARALLELISM=1

# ---------- Bootstrap Super Admin ----------
# Used once by the seed to provision the initial SUPER_ADMIN account.
SUPER_ADMIN_EMAIL=admin@afriscout.local
SUPER_ADMIN_PASSWORD=ChangeThisImmediately123!
SUPER_ADMIN_FULL_NAME=AfriScout Administrator

# ---------- CORS ----------
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# ---------- Rate Limiting ----------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
RATE_LIMIT_API_KEY_MAX=600

# ---------- Apify ----------
APIFY_TOKEN=
APIFY_BASE_URL=https://api.apify.com/v2
APIFY_OPPORTUNITY_DISCOVERY_ACTOR_ID=
APIFY_DOCUMENT_EXTRACTOR_ACTOR_ID=
APIFY_OPPORTUNITY_MONITOR_ACTOR_ID=
APIFY_WEBHOOK_SECRET=replace_with_a_long_random_string_min_32_chars
APIFY_DEFAULT_TIMEOUT_SECONDS=600
APIFY_DEFAULT_MEMORY_MB=1024

# ---------- AI Providers ----------
AI_ENABLED=true
AI_PROVIDER_PRIMARY=openai
AI_PROVIDER_FALLBACK_1=anthropic
AI_PROVIDER_FALLBACK_2=gemini
AI_PROVIDER_FALLBACK_3=mock
AI_REQUEST_TIMEOUT_MS=60000
AI_MAX_RETRIES=2

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
ANTHROPIC_BASE_URL=https://api.anthropic.com

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# ---------- Email (SMTP) ----------
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@afriscout.local
SMTP_FROM_NAME=AfriScout

# ---------- Push Notifications ----------
WEB_PUSH_ENABLED=false
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:admin@afriscout.local

# ---------- Object Storage (documents, avatars, logos) ----------
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./.storage
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# ---------- Webhooks (outbound) ----------
OUTBOUND_WEBHOOK_SECRET=replace_with_a_long_random_string_min_32_chars
OUTBOUND_WEBHOOK_MAX_ATTEMPTS=6
OUTBOUND_WEBHOOK_TIMEOUT_MS=15000

# ---------- Queue / Worker ----------
WORKER_CONCURRENCY=5
QUEUE_PREFIX=afriscout
JOB_ATTEMPTS_DEFAULT=5
JOB_BACKOFF_MS=5000

# ---------- Scheduling (fallback cron) ----------
SCHEDULER_ENABLED=true
SCHEDULER_SOURCE_TICK_CRON=*/15 * * * *
SCHEDULER_DEADLINE_TICK_CRON=0 * * * *
SCHEDULER_EXPIRY_TICK_CRON=0 2 * * *
SCHEDULER_HEALTH_TICK_CRON=*/5 * * * *

# ---------- Observability ----------
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# ---------- Feature Flags (initial defaults) ----------
FEATURE_ASK_AFRISCOUT=true
FEATURE_OPPORTUNITY_MAP=true
FEATURE_API_PORTAL=true
FEATURE_PUBLIC_API=true

# ---------- Rate limits per plan (used by API key middleware) ----------
PLAN_FREE_RPM=60
PLAN_PRO_RPM=300
PLAN_BUSINESS_RPM=1200
PLAN_ENTERPRISE_RPM=6000