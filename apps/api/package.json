{
  "name": "@afriscout/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/workers/worker.entry.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "start:worker": "node dist/workers/worker.entry.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint \"src/**/*.ts\" --max-warnings=0",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "test": "vitest run",
    "test:watch": "vitest",

    "db:generate": "prisma generate --schema src/database/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema src/database/prisma/schema.prisma",
    "db:migrate:deploy": "prisma migrate deploy --schema src/database/prisma/schema.prisma",
    "db:reset": "prisma migrate reset --schema src/database/prisma/schema.prisma",
    "db:seed": "tsx src/database/prisma/seed/index.ts",
    "db:studio": "prisma studio --schema src/database/prisma/schema.prisma"
  },
  "dependencies": {
    "@afriscout/shared": "*",
    "@prisma/client": "^5.16.1",
    "argon2": "^0.40.3",
    "bullmq": "^5.8.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "hpp": "^0.2.3",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.9.14",
    "pino": "^9.2.0",
    "pino-pretty": "^11.2.1",
    "yaml": "^2.4.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.10",
    "@types/nodemailer": "^6.4.15",
    "prisma": "^5.16.1",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vitest": "^2.0.2"
  }
}