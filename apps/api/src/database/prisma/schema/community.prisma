enum CommunityPostKind {
  GENERAL
  OPPORTUNITY_DISCUSSION
  QUESTION
  ACHIEVEMENT
  PROJECT_ANNOUNCEMENT
  EDUCATIONAL
  INDUSTRY_DISCUSSION
}

enum CommunityReportStatus {
  OPEN
  REVIEWED
  RESOLVED
  DISMISSED
}

enum CommunityActionKind {
  BLOCK
  MUTE
}

enum CommunityConnectionStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum OpportunityInteractionType {
  LIKE
  INTERESTED
  APPLYING
  COMPLETED
  SHARE
}

model CommunitySpace {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  slug        String   @unique
  description String?
  countryCode String?  @map("country_code") @db.Char(2)
  topics      String[] @default([])
  createdAt   DateTime @default(now()) @map("created_at")
  posts       CommunityPost[]
  @@map("community_spaces")
}

model CommunityPost {
  id            String             @id @default(uuid()) @db.Uuid
  authorId      String             @map("author_id") @db.Uuid
  opportunityId String?            @map("opportunity_id") @db.Uuid
  organizationId String?           @map("organization_id") @db.Uuid
  communitySlug String?            @map("community_slug")
  topics        String[]           @default([])
  industries    String[]           @default([])
  kind          CommunityPostKind  @default(GENERAL)
  content       String             @db.VarChar(5000)
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")
  author        User               @relation("CommunityPostAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  opportunity   Opportunity?       @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  organization  Organization?      @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  community     CommunitySpace?    @relation(fields: [communitySlug], references: [slug], onDelete: SetNull)
  comments      CommunityComment[]
  reactions     CommunityReaction[]
  reports       CommunityReport[]

  @@index([createdAt(sort: Desc)])
  @@index([authorId, createdAt(sort: Desc)])
  @@index([opportunityId, createdAt(sort: Desc)])
  @@map("community_posts")
}

model CommunityComment {
  id        String            @id @default(uuid()) @db.Uuid
  postId    String            @map("post_id") @db.Uuid
  authorId  String            @map("author_id") @db.Uuid
  content   String            @db.VarChar(2000)
  createdAt DateTime          @default(now()) @map("created_at")
  post      CommunityPost     @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User              @relation("CommunityCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  reports   CommunityReport[]

  @@index([postId, createdAt])
  @@map("community_comments")
}

model CommunityReaction {
  id        String        @id @default(uuid()) @db.Uuid
  postId    String        @map("post_id") @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  createdAt DateTime      @default(now()) @map("created_at")
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId])
  @@map("community_reactions")
}

model CommunityFollow {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  targetType String   @map("target_type") @db.VarChar(24)
  targetKey  String   @map("target_key") @db.VarChar(160)
  createdAt  DateTime @default(now()) @map("created_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetType, targetKey])
  @@index([targetType, targetKey])
  @@map("community_follows")
}

model CommunityReport {
  id             String                @id @default(uuid()) @db.Uuid
  reporterId     String                @map("reporter_id") @db.Uuid
  postId         String?               @map("post_id") @db.Uuid
  commentId      String?               @map("comment_id") @db.Uuid
  reportedUserId String?               @map("reported_user_id") @db.Uuid
  opportunityId String?                @map("opportunity_id") @db.Uuid
  organizationId String?               @map("organization_id") @db.Uuid
  reason         String                @db.VarChar(80)
  details        String?               @db.VarChar(1000)
  status         CommunityReportStatus @default(OPEN)
  createdAt      DateTime              @default(now()) @map("created_at")
  reporter       User                  @relation("CommunityReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  post           CommunityPost?        @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment        CommunityComment?     @relation(fields: [commentId], references: [id], onDelete: Cascade)
  reportedUser   User?                 @relation("CommunityReportTarget", fields: [reportedUserId], references: [id], onDelete: SetNull)
  opportunity   Opportunity?           @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  organization  Organization?          @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([reporterId, createdAt])
  @@map("community_reports")
}

model CommunityConnection {
  id          String                    @id @default(uuid()) @db.Uuid
  requesterId String                    @map("requester_id") @db.Uuid
  recipientId String                    @map("recipient_id") @db.Uuid
  status      CommunityConnectionStatus @default(PENDING)
  createdAt   DateTime                  @default(now()) @map("created_at")
  respondedAt DateTime?                 @map("responded_at")
  requester   User                      @relation("CommunityConnectionRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  recipient   User                      @relation("CommunityConnectionRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  @@unique([requesterId, recipientId])
  @@index([recipientId, status, createdAt(sort: Desc)])
  @@index([requesterId, status, createdAt(sort: Desc)])
  @@map("community_connections")
}

model ProfileAnalysis {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  profileHash String   @map("profile_hash")
  result      Json
  provider    String?
  createdAt   DateTime @default(now()) @map("created_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt(sort: Desc)])
  @@map("profile_analyses")
}

model OpportunityInteraction {
  id             String                     @id @default(uuid()) @db.Uuid
  userId         String                     @map("user_id") @db.Uuid
  opportunityId  String                     @map("opportunity_id") @db.Uuid
  kind           OpportunityInteractionType
  createdAt      DateTime                   @default(now()) @map("created_at")
  user           User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunity    Opportunity                @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  @@unique([userId, opportunityId, kind])
  @@index([opportunityId, kind])
  @@index([userId, createdAt(sort: Desc)])
  @@map("opportunity_interactions")
}

model SourceVerification {
  id            String    @id @default(uuid()) @db.Uuid
  sourceId      String    @map("source_id") @db.Uuid
  version       Int
  snapshot      Json
  fingerprint   String
  status        String    @default("PENDING")
  walletAddress String?   @map("wallet_address")
  txSignature   String?   @unique @map("tx_signature")
  anchoredAt    DateTime? @map("anchored_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  source        Source    @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  @@unique([sourceId, version])
  @@index([sourceId, createdAt(sort: Desc)])
  @@map("source_verifications")
}

model CommunityUserAction {
  id         String              @id @default(uuid()) @db.Uuid
  actorId    String              @map("actor_id") @db.Uuid
  targetId   String              @map("target_id") @db.Uuid
  kind       CommunityActionKind
  createdAt  DateTime            @default(now()) @map("created_at")
  actor      User                @relation("CommunityActionActor", fields: [actorId], references: [id], onDelete: Cascade)
  target     User                @relation("CommunityActionTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([actorId, targetId, kind])
  @@index([targetId, kind])
  @@map("community_user_actions")
}
