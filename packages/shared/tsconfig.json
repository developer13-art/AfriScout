{
  "extends": "../config/typescript/library.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "composite": false,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "strict": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}